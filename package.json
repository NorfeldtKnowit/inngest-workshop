{
  "name": "inngest-workshop",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo run dev:next inngest:dev db:studio --ui=tui",
    "dev:concurrently": "concurrently --names \"NEXT,INNGEST,DB\" --prefix-colors \"blue,green,yellow\" \"next dev\" \"pnpm run inngest:dev\" \"pnpm run db:studio\"",
    "dev:next": "next dev",
    "inngest:dev": "pnpm dlx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:exercise1": "playwright test exercise1-prepare-food",
    "test:exercise2": "playwright test exercise2-warmer-management",
    "test:exercise3": "playwright test exercise3-fulfill-order",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "setup": "pnpm install && pnpm run db:push",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "preinstall": "pnpm audit --audit-level=moderate || true"
  },
  "dependencies": {
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@tanstack/react-query": "5.89.0",
    "better-sqlite3": "12.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "12.23.22",
    "inngest": "3.54.2",
    "lucide-react": "0.544.0",
    "next": "15.5.20",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.20",
    "tailwindcss": "4.1.13",
